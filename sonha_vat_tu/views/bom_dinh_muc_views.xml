<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bom_dinh_muc_tree" model="ir.ui.view">
        <field name="name">bom.dinh.muc.tree</field>
        <field name="model">bom.dinh.muc</field>
        <field name="arch" type="xml">
            <tree duplicate="0" editable="bottom" class="sh_free_width_tree">
                <field name="company_id" string="Đơn vị"
                       options="{'no_create': True}"
                       context="{'vat_tu_company_code_display': True}"/>
                <field name="ma_tp_line_id" string="Mã thành phẩm"
                       context="{'vat_tu_display_ma_code_only': True}"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="ten_tp" string="Tên thành phẩm" readonly="1" optional="show"/>
                <field name="ma_nvl_id" string="Mã NVL"
                       context="{'vat_tu_display_ma_code_only': True}"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="ten_nvl" string="Tên NVL" readonly="1" optional="show"/>
                <field name="ma_tp" column_invisible="True"/>
                <field name="ma_nvl" column_invisible="True"/>
                <field name="sl_dinh_muc" string="Định mức" readonly="1"/>
                <field name="sl_dinh_muc_thay_doi" string="Định mức thay đổi"/>
            </tree>
        </field>
    </record>

    <record id="view_bom_dinh_muc_search" model="ir.ui.view">
        <field name="name">bom.dinh.muc.search</field>
        <field name="model">bom.dinh.muc</field>
        <field name="arch" type="xml">
            <search>
                <field name="company_id" context="{'vat_tu_company_code_display': True}"/>
                <field name="ma_tp_line_id" string="Mã thành phẩm"
                       context="{'vat_tu_display_ma_code_only': True}"/>
                <field name="ma_nvl_id" string="Mã NVL"
                       context="{'vat_tu_display_ma_code_only': True}"/>
                <field name="ma_tp"/>
                <field name="ma_nvl"/>
                <field name="ten_tp"/>
                <field name="ten_nvl"/>
            </search>
        </field>
    </record>

    <record id="action_bom_dinh_muc" model="ir.actions.act_window">
        <field name="name">BOM</field>
        <field name="res_model">bom.dinh.muc</field>
        <field name="view_mode">tree</field>
        <field name="context">{'vat_tu_company_code_display': True}</field>
    </record>
</odoo>
