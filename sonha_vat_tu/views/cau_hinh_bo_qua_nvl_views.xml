<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cau_hinh_bo_qua_nvl_tree" model="ir.ui.view">
        <field name="name">cau.hinh.bo.qua.nvl.tree</field>
        <field name="model">cau.hinh.bo.qua.nvl</field>
        <field name="arch" type="xml">
            <tree duplicate="0" editable="bottom" class="sh_free_width_tree">
                <field name="company_sx_id" string="Đơn vị sản xuất" required="1"
                       options="{'no_create': True}"
                       context="{'vat_tu_company_code_display': True}"/>
                <field name="ma_nvl_id" string="Mã NVL bỏ qua"
                       context="{'vat_tu_display_ma_code_only': True}"
                       options="{'no_create': True, 'no_open': True}"/>
                <field name="ten_nvl" string="Tên NVL" readonly="1"/>
                <field name="active" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <record id="view_cau_hinh_bo_qua_nvl_search" model="ir.ui.view">
        <field name="name">cau.hinh.bo.qua.nvl.search</field>
        <field name="model">cau.hinh.bo.qua.nvl</field>
        <field name="arch" type="xml">
            <search>
                <field name="company_sx_id" context="{'vat_tu_company_code_display': True}"/>
                <field name="ma_nvl_id" context="{'vat_tu_display_ma_code_only': True}"/>
                <field name="ten_nvl"/>
                <filter name="filter_active" string="Đang dùng" domain="[('active', '=', True)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_company_sx" string="ĐV SX"
                            context="{'group_by': 'company_sx_id', 'vat_tu_company_code_display': True}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cau_hinh_bo_qua_nvl" model="ir.actions.act_window">
        <field name="name">Cấu hình bỏ qua mã NVL</field>
        <field name="res_model">cau.hinh.bo.qua.nvl</field>
        <field name="view_mode">tree</field>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

</odoo>
