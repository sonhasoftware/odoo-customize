<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bao_cao_vt_can_dat_wizard_form" model="ir.ui.view">
        <field name="name">bao.cao.vt.can.dat.wizard.form</field>
        <field name="model">bao.cao.vt.can.dat.wizard</field>
        <field name="arch" type="xml">
            <form string="Báo cáo vật tư cần đặt">
                <group>
                    <field name="report_kind" invisible="1"/>
                    <field name="period_ids"
                           widget="many2many_tags"
                           options="{'no_create': True, 'no_open': True}"/>
                </group>
                <footer>
                    <button name="action_open_report" type="object"
                            string="Xem báo cáo" class="btn-primary"/>
                    <button string="Huỷ" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bao_cao_vt_can_dat_kiem_tra_wizard" model="ir.actions.act_window">
        <field name="name">Biểu in kiểm tra vật tư cần đặt</field>
        <field name="res_model">bao.cao.vt.can.dat.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_kind': 'kiem_tra'}</field>
        <field name="view_id" ref="view_bao_cao_vt_can_dat_wizard_form"/>
    </record>

    <record id="action_bao_cao_vt_can_dat_trinh_ld_wizard" model="ir.actions.act_window">
        <field name="name">Biểu in trình lãnh đạo</field>
        <field name="res_model">bao.cao.vt.can.dat.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_kind': 'trinh_ld'}</field>
        <field name="view_id" ref="view_bao_cao_vt_can_dat_wizard_form"/>
    </record>

    <record id="view_bao_cao_vt_can_dat_line_tree" model="ir.ui.view">
        <field name="name">bao.cao.vt.can.dat.line.tree</field>
        <field name="model">bao.cao.vt.can.dat.line</field>
        <field name="arch" type="xml">
            <tree string="Chi tiết vật tư cần in"
                  create="false" delete="false"
                  export_xlsx="0" import="0"
                  class="sh_free_width_tree o_vat_tu_vtcd_report"
                  js_class="vat_tu_bao_cao_vtcd_list_view">
                <field name="sequence" column_invisible="1"/>
                <field name="row_type" column_invisible="1"/>
                <field name="label" column_invisible="1"/>
                <field name="ma_nvl" column_invisible="1"/>
                <field name="ten_nvl" column_invisible="1"/>
                <field name="chat_lieu" column_invisible="1"/>
                <field name="do_bong" column_invisible="1"/>
                <field name="do_day" column_invisible="1"/>
                <field name="kho_rong" column_invisible="1"/>
                <field name="metrics_json" column_invisible="1"/>
                <field name="ghi_chu" column_invisible="1"/>
                <field name="wizard_id" column_invisible="1"/>
                <field name="report_kind" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="action_export_bao_cao_vt_can_dat_excel" model="ir.actions.server">
        <field name="name">Xuất Excel</field>
        <field name="model_id" ref="model_bao_cao_vt_can_dat_line"/>
        <field name="binding_model_id" ref="model_bao_cao_vt_can_dat_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = (records or env['bao.cao.vt.can.dat.line']).action_export_excel()
        </field>
    </record>

    <record id="action_print_bao_cao_vt_can_dat_pdf" model="ir.actions.server">
        <field name="name">Xuất PDF</field>
        <field name="model_id" ref="model_bao_cao_vt_can_dat_line"/>
        <field name="binding_model_id" ref="model_bao_cao_vt_can_dat_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = (records or env['bao.cao.vt.can.dat.line']).action_print_pdf()
        </field>
    </record>

</odoo>
