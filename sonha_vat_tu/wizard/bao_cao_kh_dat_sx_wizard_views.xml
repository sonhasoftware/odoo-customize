<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bao_cao_kh_dat_sx_wizard_form" model="ir.ui.view">
        <field name="name">bao.cao.kh.dat.sx.wizard.form</field>
        <field name="model">bao.cao.kh.dat.sx.wizard</field>
        <field name="arch" type="xml">
            <form string="Tổng hợp kế hoạch sản xuất">
                <group>
                    <field name="period_ids"
                           widget="many2many_tags"
                           options="{'no_create': True, 'no_open': True}"/>
                </group>
                <footer>
                    <button name="action_open_report" type="object"
                            string="Xem báo cáo" class="btn-primary"/>
                    <button string="Huỷ" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bao_cao_kh_dat_sx_wizard" model="ir.actions.act_window">
        <field name="name">Tổng hợp kế hoạch sản xuất</field>
        <field name="res_model">bao.cao.kh.dat.sx.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_bao_cao_kh_dat_sx_wizard_form"/>
    </record>

    <record id="view_bao_cao_kh_dat_sx_line_tree" model="ir.ui.view">
        <field name="name">bao.cao.kh.dat.sx.line.tree</field>
        <field name="model">bao.cao.kh.dat.sx.line</field>
        <field name="arch" type="xml">
            <tree string="Tổng hợp kế hoạch sản xuất"
                  create="false" delete="false" edit="false"
                  export_xlsx="0" import="0"
                  class="sh_free_width_tree o_vat_tu_khdsx_report"
                  js_class="vat_tu_bao_cao_khdsx_list_view">
                <field name="company_sx_code" column_invisible="1"/>
                <field name="company_dat_code" column_invisible="1"/>
                <field name="nganh_hang" column_invisible="1"/>
                <field name="ton_dau_ky" column_invisible="1"/>
                <field name="metrics_json" column_invisible="1"/>
                <field name="ton_kho_month" column_invisible="1"/>
                <field name="period_month" column_invisible="1"/>
                <field name="wizard_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="action_export_bao_cao_kh_dat_sx_server" model="ir.actions.server">
        <field name="name">Xuất Excel</field>
        <field name="model_id" ref="model_bao_cao_kh_dat_sx_line"/>
        <field name="binding_model_id" ref="model_bao_cao_kh_dat_sx_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = (records or env['bao.cao.kh.dat.sx.line']).action_export_excel()
        </field>
    </record>

</odoo>
