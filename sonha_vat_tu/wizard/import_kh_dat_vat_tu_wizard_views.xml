<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_import_kh_dat_vat_tu_wizard_form" model="ir.ui.view">
        <field name="name">import.kh.dat.vat.tu.wizard.form</field>
        <field name="model">import.kh.dat.vat.tu.wizard</field>
        <field name="arch" type="xml">
            <form string="Import kế hoạch đặt vật tư">
                <sheet>
                    <group>
                        <field name="period_id"
                               readonly="context.get('period_id_readonly', False)"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="file_data" filename="file_name"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Hủy" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_kh_dat_vat_tu_server" model="ir.actions.server">
        <field name="name">Import kế hoạch đặt vật tư</field>
        <field name="model_id" ref="model_ke_hoach_vat_tu"/>
        <field name="binding_model_id" ref="model_ke_hoach_vat_tu"/>
        <field name="binding_view_types">form</field>
        <field name="groups_id" eval="[(4, ref('sonha_vat_tu.group_bo_phan_vat_tu')), (4, ref('sonha_vat_tu.group_truong_bo_phan_vat_tu'))]"/>
        <field name="state">code</field>
        <field name="code">
            if records:
                action = records.action_open_import_kh_dat_vat_tu_wizard()
        </field>
    </record>

</odoo>
