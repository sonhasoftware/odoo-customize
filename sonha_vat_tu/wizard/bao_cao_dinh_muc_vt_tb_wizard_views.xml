<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bao_cao_dinh_muc_vt_tb_wizard_form" model="ir.ui.view">
        <field name="name">bao.cao.dinh.muc.vt.tb.wizard.form</field>
        <field name="model">bao.cao.dinh.muc.vt.tb.wizard</field>
        <field name="arch" type="xml">
            <form string="Báo cáo định mức vật tư trung bình">
                <group>
                    <field name="period_ids"
                           widget="many2many_tags"
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="nhom_id" options="{'no_create': True}"/>
                    <field name="nguon_sl_sp" widget="radio"/>
                </group>
                <footer>
                    <button name="action_open_report" type="object"
                            string="Xem báo cáo" class="btn-primary"/>
                    <button string="Huỷ" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bao_cao_dinh_muc_vt_tb_wizard" model="ir.actions.act_window">
        <field name="name">Định mức vật tư trung bình</field>
        <field name="res_model">bao.cao.dinh.muc.vt.tb.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_bao_cao_dinh_muc_vt_tb_wizard_form"/>
    </record>

    <record id="view_bao_cao_dinh_muc_vt_tb_line_tree" model="ir.ui.view">
        <field name="name">bao.cao.dinh.muc.vt.tb.line.tree</field>
        <field name="model">bao.cao.dinh.muc.vt.tb.line</field>
        <field name="arch" type="xml">
            <tree string="Định mức vật tư trung bình"
                  create="false" delete="false"
                  export_xlsx="0" import="0"
                  class="sh_free_width_tree o_vat_tu_dmtb_report"
                  js_class="vat_tu_bao_cao_dmtb_list_view">
                <field name="company_code" column_invisible="1"/>
                <field name="nganh_hang_label" column_invisible="1"/>
                <field name="is_btp_row" column_invisible="1"/>
                <field name="is_total_row" column_invisible="1"/>
                <field name="sequence" column_invisible="1"/>
                <field name="row_key" column_invisible="1"/>
                <field name="metrics_json" column_invisible="1"/>
                <field name="ghi_chu" column_invisible="1"/>
                <field name="wizard_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="action_export_bao_cao_dinh_muc_vt_tb_server" model="ir.actions.server">
        <field name="name">Xuất Excel</field>
        <field name="model_id" ref="model_bao_cao_dinh_muc_vt_tb_line"/>
        <field name="binding_model_id" ref="model_bao_cao_dinh_muc_vt_tb_line"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
               action = (records or env['bao.cao.dinh.muc.vt.tb.line']).action_export_excel()
        </field>
    </record>

</odoo>
