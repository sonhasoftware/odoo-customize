<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tra_cuu_bom_wizard_form" model="ir.ui.view">
        <field name="name">tra.cuu.bom.wizard.form</field>
        <field name="model">tra.cuu.bom.wizard</field>
        <field name="arch" type="xml">
            <form string="Tra cứu Bom định mức">
                <group>
                    <field name="period_id" options="{'no_create': True}"/>
                    <field name="thang_tu" placeholder="09/2026"/>
                    <field name="thang_den" placeholder="12/2026"/>
                </group>
                <footer>
                    <button name="action_search" type="object"
                            string="Tìm" class="btn-primary"/>
                    <button string="Huỷ" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_tra_cuu_bom_wizard" model="ir.actions.act_window">
        <field name="name">Tra cứu Bom định mức</field>
        <field name="res_model">tra.cuu.bom.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_tra_cuu_bom_wizard_form"/>
    </record>

</odoo>
