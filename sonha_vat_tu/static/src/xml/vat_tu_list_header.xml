<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Báo cáo B3/B4: hiện bánh răng + action server khi chưa chọn dòng -->
    <t t-name="sonha_vat_tu.VatTuBaoCaoListView" t-inherit="web.ListView" t-inherit-mode="primary">
        <xpath expr="//t[@t-set-slot='control-panel-additional-actions']/CogMenu" position="replace">
            <CogMenu t-if="!nbSelected and props.info.actionMenus"
                getActiveIds="() => []"
                context="props.context"
                domain="props.domain"
                items="baoCaoCogMenuItems"
                isDomainSelected="model.root.isDomainSelected"
                resModel="model.root.resModel"
                onActionExecuted="() => model.load()"/>
        </xpath>
    </t>

    <!-- Ẩn các nút display="always" (như nút Import ở header) khi đang edit dòng (editedRecord) -->
    <t t-inherit="web.ListView" t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='control-panel-always-buttons']" position="replace">
            <t t-set-slot="control-panel-always-buttons">
                <t t-if="!editedRecord">
                    <t t-foreach="archInfo.headerButtons" t-as="button" t-key="button.id" t-if="!evalViewModifier(button.invisible)">
                        <MultiRecordViewButton
                            t-if="button.display === 'always'"
                            list="model.root"
                            className="button.className"
                            clickParams="button.clickParams"
                            defaultRank="'btn-secondary'"
                            domain="props.domain"
                            icon="button.icon"
                            string="button.string"
                            title="button.title"
                        />
                    </t>
                </t>
            </t>
        </xpath>
    </t>

    <!-- Header 2 tầng dùng chung: B4, B5, Báo cáo nhu cầu -->
    <t t-name="sonha_vat_tu.VatTuMergedHeaderRenderer">
        <t t-set="_canSelectRecord" t-value="canSelectRecord"/>
        <div
            class="o_list_renderer o_renderer o_vat_tu_merged_list"
            t-att-class="uniqueRendererClass"
            tabindex="-1"
            t-ref="root"
        >
            <t t-if="showNoContentHelper" t-call="web.ActionHelper">
                <t t-set="noContentHelp" t-value="props.noContentHelp"/>
            </t>
            <table t-attf-class="o_list_table table table-sm table-hover position-relative mb-0 {{props.list.isGrouped ? 'o_list_table_grouped' : 'o_list_table_ungrouped table-striped'}}" t-ref="table">
                <thead>
                   <tr class="text-center fw-bold">
                        <th t-if="hasSelectors"
                            rowspan="2"
                            class="o_list_record_selector o_list_controller align-middle pe-1 cursor-pointer"
                            tabindex="-1"
                            t-on-keydown="(ev) =&gt; this.onCellKeydown(ev)"
                            t-on-click.stop="toggleSelection">
                            <CheckBox disabled="!_canSelectRecord" value="selectAll" className="'d-flex m-0'" onChange.bind="toggleSelection"/>
                        </th>
                        <t t-foreach="getColumnGroups()" t-as="group" t-key="group.id">
                            <!-- Case 1: group bound to a real field column (enable sort/handlers) -->
                            <t t-if="group.column and group.column.type === 'field'">
                                <th t-att-colspan="group.span"
                                    t-att-rowspan="group.rowspan || 1"
                                    class="align-middle text-center"
                                    t-att-data-name="group.column.name"
                                    t-on-pointerup="onColumnTitleMouseUp"
                                    t-on-click="() =&gt; this.onClickSortColumn(group.column)"
                                    t-on-keydown="(ev) =&gt; this.onCellKeydown(ev)"
                                    data-tooltip-delay="1000"
                                    tabindex="-1">
                                    <t t-set="isNumeric" t-value="isNumericColumn(group.column)"/>
                                    <div class="d-flex align-items-center justify-content-center"
                                         t-att-data-tooltip-template="isDebugMode ? 'web.FieldTooltip' : 'web.ListHeaderTooltip'"
                                         t-att-data-tooltip-info="makeTooltip(group.column)">
                                        <span t-att-class="(group.rowspan || 1) === 1 ? 'd-block text-nowrap' : 'd-block min-w-0 text-truncate flex-grow-1 flex-shrink-1' + (isNumeric ? ' o_list_number_th' : '')"
                                              t-esc="group.label"/>
                                        <div class="o_list_header_label_spacer"/>
                                        <i class="o_list_sortable_caret" t-att-class="getSortableIconClass(group.column)"/>
                                    </div>
                                    <span class="o_resize position-absolute top-0 end-0 bottom-0 ps-1 bg-black-25 opacity-0 opacity-50-hover z-index-1"
                                          t-on-pointerdown.stop.prevent="onStartResize"/>
                                </th>
                            </t>
                            <!-- Case 2: selector/others (no handlers) -->
                            <t t-else="">
                                <th t-att-colspan="group.span"
                                    t-att-rowspan="group.rowspan || 1"
                                    class="align-middle text-center"
                                    tabindex="-1">
                                    <!-- selector column -->
                                    <t t-if="group.column and group.column.type === 'selector'">
                                        <div class="o_list_record_selector o_list_controller align-middle pe-1 cursor-pointer"
                                             t-on-click.stop="toggleSelection">
                                            <CheckBox disabled="!_canSelectRecord" value="selectAll" className="'d-flex m-0'" onChange.bind="toggleSelection"/>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <span t-esc="group.label"/>
                                    </t>
                                </th>
                            </t>
                        </t>
                        <th t-if="props.onOpenFormView" rowspan="2" class="align-middle"/>
                        <th t-if="displayOptionalFields or activeActions.onDelete"
                            rowspan="2"
                            t-on-keydown="(ev) =&gt; this.onCellKeydown(ev)"
                            class="o_list_controller o_list_actions_header w-print-0 p-print-0 position-sticky end-0 align-middle">
                            <Dropdown t-if="displayOptionalFields"
                                class="'o_optional_columns_dropdown text-center border-top-0'"
                                togglerClass="'btn p-0'"
                                skipTogglerTabbing="true"
                                listRendererClass="uniqueRendererClass"
                                position="'bottom-end'">
                                <t t-set-slot="toggler">
                                    <i class="o_optional_columns_dropdown_toggle oi oi-fw oi-settings-adjust"/>
                                </t>
                                <t t-foreach="optionalFieldGroups" t-as="group" t-key="group_index">
                                    <div t-if="!group_first" role="separator" class="dropdown-divider"/>
                                    <DropdownItem t-if="group.displayName" parentClosingMode="'none'" onSelected="() =&gt; this.toggleOptionalFieldGroup(group.id)">
                                        <div class="fw-bold" t-esc="group.displayName"/>
                                    </DropdownItem>
                                    <t t-foreach="group.optionalFields" t-as="field" t-key="field_index">
                                        <DropdownItem parentClosingMode="'none'" onSelected="() =&gt; this.toggleOptionalField(field.name)">
                                            <CheckBox
                                                onChange="() =&gt; this.toggleOptionalField(field.name)"
                                                value="field.value"
                                                name="field.name"
                                            >
                                                <span class="d-flex align-items-center"><span class="text-truncate" t-esc="field.label"/><span class="ps-1" t-if="env.debug" t-esc="' (' + field.name + ')'" /></span>
                                            </CheckBox>
                                        </DropdownItem>
                                    </t>
                                </t>
                            </Dropdown>
                        </th>
                   </tr>

                    <tr>
                        <!-- Only display merged columns in Row 2 -->
                        <t t-foreach="getMergeColumns()" t-as="column" t-key="column.id">
                            <th t-if="column.type === 'field'"
                                t-att-data-name="column.name"
                                t-att-class="getColumnClass(column) + ' opacity-trigger-hover w-print-auto align-middle text-center'"
                                t-on-pointerup="onColumnTitleMouseUp"
                                t-on-click="() =&gt; this.onClickSortColumn(column)"
                                t-on-keydown="(ev) =&gt; this.onCellKeydown(ev)"
                                data-tooltip-delay="1000"
                                tabindex="-1">
                                <t t-if="column.hasLabel and column.widget !== 'handle'">
                                <t t-set="isNumeric" t-value="isNumericColumn(column)"/>
                                    <div class="d-flex align-items-center justify-content-center"
                                         t-att-data-tooltip-template="isDebugMode ? 'web.FieldTooltip' : 'web.ListHeaderTooltip'"
                                         t-att-data-tooltip-info="makeTooltip(column)">
                                        <span class="d-block min-w-0 text-truncate flex-grow-1 flex-shrink-1" t-att-class="isNumeric ? 'o_list_number_th' : ''"
                                              t-esc="column.label"/>
                                        <div class="o_list_header_label_spacer"/>
                                        <i class="o_list_sortable_caret" t-att-class="getSortableIconClass(column)"/>
                                    </div>
                                    <span class="o_resize position-absolute top-0 end-0 bottom-0 ps-1 bg-black-25 opacity-0 opacity-50-hover z-index-1"
                                          t-on-pointerdown.stop.prevent="onStartResize"/>
                                </t>
                            </th>
                            <th t-else="" t-on-keydown="(ev) =&gt; this.onCellKeydown(ev)" t-att-class="{'o_list_button w-print-0 p-print-0 align-middle': column.type === 'button_group'}"/>
                        </t>
                    </tr>
                </thead>
                <tbody class="ui-sortable">
                    <t t-call="{{ constructor.rowsTemplate }}">
                        <t t-set="list" t-value="props.list"/>
                    </t>
                </tbody>
                <tfoot t-on-click="() =&gt; props.list.leaveEditMode()" class="o_list_footer cursor-default" t-att-class="{o_sample_data_disabled: props.list.model.useSampleModel}">
                    <tr>
                        <td t-if="hasSelectors"/>
                        <t t-foreach="state.columns" t-as="column" t-key="column.id">
                            <t t-set="aggregate" t-value="aggregates[column.name]"/>
                            <td t-if="aggregate" class="o_list_number" >
                                <span t-esc="aggregate.value" t-att-data-tooltip="aggregate.help"/>
                            </td>
                            <td t-else=""/>
                        </t>
                        <td t-if="props.onOpenFormView" class="w-print-0 p-print-0"/>
                        <td t-if="displayOptionalFields or activeActions.onDelete" class="w-print-0 p-print-0" />
                    </tr>
                </tfoot>
            </table>
        </div>
    </t>

    <!-- Header 3 tầng B5: Đi đường = Tháng × (SL, ĐG, GT) -->
    <t t-name="sonha_vat_tu.VatTuMergedB5HeaderRenderer">
        <t t-set="_canSelectRecord" t-value="canSelectRecord"/>
        <div
            class="o_list_renderer o_renderer o_vat_tu_merged_list o_vat_tu_merged_b5"
            t-att-class="uniqueRendererClass"
            tabindex="-1"
            t-ref="root"
        >
            <t t-if="showNoContentHelper" t-call="web.ActionHelper">
                <t t-set="noContentHelp" t-value="props.noContentHelp"/>
            </t>
            <table t-attf-class="o_list_table table table-sm table-hover position-relative mb-0 {{props.list.isGrouped ? 'o_list_table_grouped' : 'o_list_table_ungrouped table-striped'}}" t-ref="table">
                <thead>
                    <tr class="text-center fw-bold">
                        <th t-if="hasSelectors"
                            t-att-rowspan="mergedHeaderDepth"
                            class="o_list_record_selector o_list_controller align-middle pe-1 cursor-pointer"
                            tabindex="-1"
                            t-on-keydown="(ev) =&gt; this.onCellKeydown(ev)"
                            t-on-click.stop="toggleSelection">
                            <CheckBox disabled="!_canSelectRecord" value="selectAll" className="'d-flex m-0'" onChange.bind="toggleSelection"/>
                        </th>
                        <t t-foreach="getTopRowGroups()" t-as="group" t-key="group.id">
                            <t t-if="group.column and group.column.type === 'field'">
                                <th t-att-colspan="group.span"
                                    t-att-rowspan="group.rowspan || 1"
                                    class="align-middle text-center"
                                    t-att-data-name="group.column.name"
                                    t-on-pointerup="onColumnTitleMouseUp"
                                    t-on-click="() =&gt; this.onClickSortColumn(group.column)"
                                    t-on-keydown="(ev) =&gt; this.onCellKeydown(ev)"
                                    data-tooltip-delay="1000"
                                    tabindex="-1">
                                    <t t-set="isNumeric" t-value="isNumericColumn(group.column)"/>
                                    <div class="d-flex align-items-center justify-content-center"
                                         t-att-data-tooltip-template="isDebugMode ? 'web.FieldTooltip' : 'web.ListHeaderTooltip'"
                                         t-att-data-tooltip-info="makeTooltip(group.column)">
                                        <span t-att-class="(group.rowspan || 1) === 1 ? 'd-block text-nowrap' : 'd-block min-w-0 text-truncate flex-grow-1 flex-shrink-1' + (isNumeric ? ' o_list_number_th' : '')"
                                              t-esc="group.label"/>
                                        <div class="o_list_header_label_spacer"/>
                                        <i class="o_list_sortable_caret" t-att-class="getSortableIconClass(group.column)"/>
                                    </div>
                                    <span class="o_resize position-absolute top-0 end-0 bottom-0 ps-1 bg-black-25 opacity-0 opacity-50-hover z-index-1"
                                          t-on-pointerdown.stop.prevent="onStartResize"/>
                                </th>
                            </t>
                            <t t-else="">
                                <th t-att-colspan="group.span"
                                    t-att-rowspan="group.rowspan || 1"
                                    class="align-middle text-center"
                                    tabindex="-1">
                                    <t t-if="group.column and group.column.type === 'selector'">
                                        <div class="o_list_record_selector o_list_controller align-middle pe-1 cursor-pointer"
                                             t-on-click.stop="toggleSelection">
                                            <CheckBox disabled="!_canSelectRecord" value="selectAll" className="'d-flex m-0'" onChange.bind="toggleSelection"/>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <span t-esc="group.label"/>
                                    </t>
                                </th>
                            </t>
                        </t>
                        <th t-if="props.onOpenFormView" t-att-rowspan="mergedHeaderDepth" class="align-middle"/>
                        <th t-if="displayOptionalFields or activeActions.onDelete"
                            t-att-rowspan="mergedHeaderDepth"
                            t-on-keydown="(ev) =&gt; this.onCellKeydown(ev)"
                            class="o_list_controller o_list_actions_header w-print-0 p-print-0 position-sticky end-0 align-middle">
                            <Dropdown t-if="displayOptionalFields"
                                class="'o_optional_columns_dropdown text-center border-top-0'"
                                togglerClass="'btn p-0'"
                                skipTogglerTabbing="true"
                                listRendererClass="uniqueRendererClass"
                                position="'bottom-end'">
                                <t t-set-slot="toggler">
                                    <i class="o_optional_columns_dropdown_toggle oi oi-fw oi-settings-adjust"/>
                                </t>
                                <t t-foreach="optionalFieldGroups" t-as="group" t-key="group_index">
                                    <div t-if="!group_first" role="separator" class="dropdown-divider"/>
                                    <DropdownItem t-if="group.displayName" parentClosingMode="'none'" onSelected="() =&gt; this.toggleOptionalFieldGroup(group.id)">
                                        <div class="fw-bold" t-esc="group.displayName"/>
                                    </DropdownItem>
                                    <t t-foreach="group.optionalFields" t-as="field" t-key="field_index">
                                        <DropdownItem parentClosingMode="'none'" onSelected="() =&gt; this.toggleOptionalField(field.name)">
                                            <CheckBox
                                                onChange="() =&gt; this.toggleOptionalField(field.name)"
                                                value="field.value"
                                                name="field.name"
                                            >
                                                <span class="d-flex align-items-center"><span class="text-truncate" t-esc="field.label"/><span class="ps-1" t-if="env.debug" t-esc="' (' + field.name + ')'" /></span>
                                            </CheckBox>
                                        </DropdownItem>
                                    </t>
                                </t>
                            </Dropdown>
                        </th>
                    </tr>

                    <tr class="text-center fw-bold">
                        <t t-foreach="getMidRowGroups()" t-as="group" t-key="group.id">
                            <th t-if="group.column and group.column.type === 'field'"
                                t-att-colspan="group.span"
                                t-att-rowspan="group.rowspan || 1"
                                class="align-middle text-center"
                                t-att-data-name="group.column.name"
                                t-on-pointerup="onColumnTitleMouseUp"
                                t-on-click="() =&gt; this.onClickSortColumn(group.column)"
                                t-on-keydown="(ev) =&gt; this.onCellKeydown(ev)"
                                data-tooltip-delay="1000"
                                tabindex="-1">
                                <t t-set="isNumeric" t-value="isNumericColumn(group.column)"/>
                                <div class="d-flex align-items-center justify-content-center"
                                     t-att-data-tooltip-template="isDebugMode ? 'web.FieldTooltip' : 'web.ListHeaderTooltip'"
                                     t-att-data-tooltip-info="makeTooltip(group.column)">
                                    <span class="d-block min-w-0 text-truncate flex-grow-1 flex-shrink-1"
                                          t-att-class="isNumeric ? ' o_list_number_th' : ''"
                                          t-esc="group.label"/>
                                    <div class="o_list_header_label_spacer"/>
                                    <i class="o_list_sortable_caret" t-att-class="getSortableIconClass(group.column)"/>
                                </div>
                                <span class="o_resize position-absolute top-0 end-0 bottom-0 ps-1 bg-black-25 opacity-0 opacity-50-hover z-index-1"
                                      t-on-pointerdown.stop.prevent="onStartResize"/>
                            </th>
                        </t>
                    </tr>

                    <tr class="text-center fw-bold">
                        <t t-foreach="getLeafMergeColumns()" t-as="column" t-key="column.id">
                            <th t-if="column.type === 'field'"
                                t-att-data-name="column.name"
                                t-att-class="getColumnClass(column) + ' opacity-trigger-hover w-print-auto align-middle text-center'"
                                t-on-pointerup="onColumnTitleMouseUp"
                                t-on-click="() =&gt; this.onClickSortColumn(column)"
                                t-on-keydown="(ev) =&gt; this.onCellKeydown(ev)"
                                data-tooltip-delay="1000"
                                tabindex="-1">
                                <t t-if="column.hasLabel and column.widget !== 'handle'">
                                    <t t-set="isNumeric" t-value="isNumericColumn(column)"/>
                                    <div class="d-flex align-items-center justify-content-center"
                                         t-att-data-tooltip-template="isDebugMode ? 'web.FieldTooltip' : 'web.ListHeaderTooltip'"
                                         t-att-data-tooltip-info="makeTooltip(column)">
                                        <span class="d-block min-w-0 text-truncate flex-grow-1 flex-shrink-1"
                                              t-att-class="isNumeric ? 'o_list_number_th' : ''"
                                              t-esc="column.label"/>
                                        <div class="o_list_header_label_spacer"/>
                                        <i class="o_list_sortable_caret" t-att-class="getSortableIconClass(column)"/>
                                    </div>
                                    <span class="o_resize position-absolute top-0 end-0 bottom-0 ps-1 bg-black-25 opacity-0 opacity-50-hover z-index-1"
                                          t-on-pointerdown.stop.prevent="onStartResize"/>
                                </t>
                            </th>
                        </t>
                    </tr>
                </thead>
                <tbody class="ui-sortable">
                    <t t-call="{{ constructor.rowsTemplate }}">
                        <t t-set="list" t-value="props.list"/>
                    </t>
                </tbody>
                <tfoot t-on-click="() =&gt; props.list.leaveEditMode()" class="o_list_footer cursor-default" t-att-class="{o_sample_data_disabled: props.list.model.useSampleModel}">
                    <tr>
                        <td t-if="hasSelectors"/>
                        <t t-foreach="state.columns" t-as="column" t-key="column.id">
                            <t t-set="aggregate" t-value="aggregates[column.name]"/>
                            <td t-if="aggregate" class="o_list_number" >
                                <span t-esc="aggregate.value" t-att-data-tooltip="aggregate.help"/>
                            </td>
                            <td t-else=""/>
                        </t>
                        <td t-if="props.onOpenFormView" class="w-print-0 p-print-0"/>
                        <td t-if="displayOptionalFields or activeActions.onDelete" class="w-print-0 p-print-0" />
                    </tr>
                </tfoot>
            </table>
        </div>
    </t>

    <!-- Pivot B3: Tháng × Đơn vị KD; dùng lại cho báo cáo B3 theo khoảng tháng -->
    <t t-name="sonha_vat_tu.VatTuB3PivotRenderer">
        <div
            class="o_list_renderer o_renderer o_vat_tu_merged_list o_vat_tu_b3_pivot"
            t-att-class="uniqueRendererClass"
            tabindex="-1"
            t-ref="root"
        >
            <t t-if="showNoContentHelper" t-call="web.ActionHelper">
                <t t-set="noContentHelp" t-value="props.noContentHelp"/>
            </t>
            <table t-attf-class="o_list_table table table-sm table-hover position-relative mb-0 o_list_table_ungrouped table-striped" t-ref="table">
                <thead>
                    <tr class="text-center fw-bold">
                        <t t-foreach="getColumnGroups()" t-as="group" t-key="group.id">
                            <th t-att-colspan="group.span"
                                t-att-rowspan="group.rowspan || 1"
                                class="align-middle text-center"
                                tabindex="-1">
                                <span t-esc="group.label"/>
                            </th>
                        </t>
                    </tr>
                    <tr class="text-center fw-bold">
                        <t t-foreach="getQtySubColumns()" t-as="col" t-key="col.id">
                            <th class="align-middle text-center o_list_number_th" tabindex="-1">
                                <span t-esc="col.label"/>
                            </th>
                        </t>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="getPivotRows()" t-as="row" t-key="row_index">
                        <tr>
                            <t t-foreach="b3FixedMeta" t-as="meta" t-key="meta.key">
                                <td class="align-middle">
                                    <span t-esc="formatMetaValue(row, meta)"/>
                                </td>
                            </t>
                            <t t-foreach="getQtySubColumns()" t-as="col" t-key="col.id">
                                <td class="align-middle text-end o_list_number">
                                    <span t-if="col.isTotal"
                                          t-esc="formatQty(pivotTotal(row, col.monthRef))"/>
                                    <span t-else=""
                                          t-esc="formatQty(pivotQty(row, col.monthRef, col.companyId))"/>
                                </td>
                            </t>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>
    </t>

    <!-- Báo cáo B4 theo khoảng tháng -->
    <t t-name="sonha_vat_tu.VatTuBaoCaoB4PivotRenderer">
        <div
            class="o_list_renderer o_renderer o_vat_tu_merged_list"
            t-att-class="uniqueRendererClass"
            tabindex="-1"
            t-ref="root"
        >
            <t t-if="showNoContentHelper" t-call="web.ActionHelper">
                <t t-set="noContentHelp" t-value="props.noContentHelp"/>
            </t>
            <table t-attf-class="o_list_table table table-sm table-hover position-relative mb-0 o_list_table_ungrouped table-striped" t-ref="table">
                <thead>
                    <tr class="text-center fw-bold">
                        <t t-foreach="getColumnGroups()" t-as="group" t-key="group.id">
                            <th t-att-colspan="group.span"
                                t-att-rowspan="group.rowspan || 1"
                                class="align-middle text-center"
                                tabindex="-1">
                                <span t-esc="group.label"/>
                            </th>
                        </t>
                    </tr>
                    <tr class="text-center fw-bold">
                        <t t-foreach="getQtySubColumns()" t-as="col" t-key="col.id">
                            <th class="align-middle text-center o_list_number_th" tabindex="-1">
                                <span t-esc="col.label"/>
                            </th>
                        </t>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="getPivotRows()" t-as="row" t-key="row_index">
                        <tr>
                            <t t-foreach="BAO_CAO_B4_META" t-as="meta" t-key="meta.key">
                                <td class="align-middle">
                                    <span t-esc="formatMetaValue(row, meta)"/>
                                </td>
                            </t>
                            <t t-foreach="getQtySubColumns()" t-as="col" t-key="col.id">
                                <td class="align-middle text-end o_list_number">
                                    <span t-esc="formatQty(metricValue(row, col.monthKey, col.groupKey))"/>
                                </td>
                            </t>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>
    </t>

    <!-- Báo cáo định mức vật tư trung bình: Công ty × Ngành × Tháng (SL SP / SL NVL / ĐMBQ) -->
    <t t-name="sonha_vat_tu.VatTuBaoCaoDmtbPivotRenderer">
        <div
            class="o_list_renderer o_renderer o_vat_tu_merged_list o_vat_tu_dmtb_pivot"
            t-att-class="uniqueRendererClass"
            tabindex="-1"
            t-ref="root"
        >
            <t t-if="showNoContentHelper" t-call="web.ActionHelper">
                <t t-set="noContentHelp" t-value="props.noContentHelp"/>
            </t>
            <table t-attf-class="o_list_table table table-sm table-hover position-relative mb-0 o_list_table_ungrouped table-striped" t-ref="table">
                <thead>
                    <tr class="text-center fw-bold">
                        <t t-foreach="getColumnGroups()" t-as="group" t-key="group.id">
                            <th t-att-colspan="group.span"
                                t-att-rowspan="group.rowspan || 1"
                                class="align-middle text-center o_dmtb_header"
                                tabindex="-1">
                                <span t-esc="group.label"/>
                            </th>
                        </t>
                    </tr>
                    <tr class="text-center fw-bold">
                        <t t-foreach="getMetricSubColumns()" t-as="col" t-key="col.id">
                            <th t-attf-class="align-middle text-center o_list_number_th o_dmtb_header o_dmtb_metric_header {{ col.isMonthStart ? 'o_dmtb_metric_month_start' : '' }}"
                                tabindex="-1">
                                <span t-esc="col.label"/>
                            </th>
                        </t>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="getCompanyGroups()" t-as="companyGroup" t-key="companyGroup.companyCode">
                        <t t-foreach="companyGroup.rows" t-as="row" t-key="row.id" t-foreach-index="row_index">
                            <tr t-if="row.data.is_section_row" t-att-class="rowClass(row)">
                                <t t-if="row_index === 0">
                                    <td t-att-rowspan="companyGroup.rows.length"
                                        class="align-middle text-center o_dmtb_company_cell">
                                        <span t-esc="companyGroup.companyCode"/>
                                    </td>
                                </t>
                                <td t-att-colspan="sectionColspan()"
                                    class="align-middle text-center">
                                    <span t-esc="row.data.section_label"/>
                                </td>
                            </tr>
                            <tr t-else="" t-att-class="rowClass(row)">
                                <t t-if="row_index === 0">
                                    <td t-att-rowspan="companyGroup.rows.length"
                                        class="align-middle text-center o_dmtb_company_cell">
                                        <span t-esc="companyGroup.companyCode"/>
                                    </td>
                                </t>
                                <td class="align-middle text-center">
                                    <span t-esc="row.data.nganh_hang_label"/>
                                </td>
                                <t t-foreach="getMetricSubColumns()" t-as="col" t-key="col.id">
                                    <td class="align-middle text-end o_list_number">
                                        <span t-esc="formatMetric(metricValue(row, col.colIndex, col.metric), col.metric, row)"/>
                                    </td>
                                </t>
                                <td class="align-middle o_dmtb_ghi_chu">
                                    <t t-if="!row.data.is_total_row">
                                        <textarea class="o_dmtb_ghi_chu_input form-control form-control-sm"
                                                  rows="2"
                                                  t-att-value="row.data.ghi_chu || ''"
                                                  t-on-change="(ev) => this.onGhiChuInput(row, ev)"
                                                  t-on-blur="(ev) => this.onGhiChuInput(row, ev)"
                                                  placeholder="Ghi chú..."/>
                                    </t>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>
        </div>
    </t>

    <!-- Biểu 2: Chi tiết vật tư cần in -->
    <t t-name="sonha_vat_tu.VatTuBaoCaoVtcdPivotRenderer">
        <div
            class="o_list_renderer o_renderer o_vat_tu_merged_list o_vat_tu_vtcd_pivot"
            t-att-class="uniqueRendererClass"
            tabindex="-1"
            t-ref="root"
        >
            <t t-if="showNoContentHelper" t-call="web.ActionHelper">
                <t t-set="noContentHelp" t-value="props.noContentHelp"/>
            </t>
            <table t-attf-class="o_list_table table table-sm table-hover position-relative mb-0 o_list_table_ungrouped table-striped" t-ref="table">
                <thead>
                    <tr class="text-center fw-bold">
                        <t t-foreach="getColumnGroups()" t-as="group" t-key="group.id">
                            <th t-att-colspan="group.span"
                                t-att-rowspan="group.rowspan || 1"
                                class="align-middle text-center o_vtcd_header"
                                tabindex="-1">
                                <span t-esc="group.label"/>
                            </th>
                        </t>
                    </tr>
                    <tr class="text-center fw-bold">
                        <t t-foreach="getMetricSubColumns()" t-as="col" t-key="col.id">
                            <th class="align-middle text-center o_list_number_th o_vtcd_header" tabindex="-1">
                                <span t-esc="col.label"/>
                            </th>
                        </t>
                    </tr>
                    <tr class="text-center o_vtcd_header_dates">
                        <t t-foreach="getMetricDateColumns()" t-as="col" t-key="col.id">
                            <th class="align-middle text-center o_vtcd_header" tabindex="-1">
                                <span t-esc="col.label"/>
                            </th>
                        </t>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="getPivotRows()" t-as="row" t-key="row.id">
                        <tr t-attf-class="#{isSubtotalRow(row) ? 'o_vtcd_subtotal_row' : ''}">
                            <t t-foreach="getFixedCols()" t-as="fixCol" t-key="fixCol.key">
                                <td t-attf-class="align-middle #{fixCol.key === 'ten_nvl' ? 'o_vtcd_ten_nvl' : ''} #{isSubtotalRow(row) and fixCol.key === 'kho_rong' ? 'fw-bold' : ''}">
                                    <span t-esc="fixedCellValue(row, fixCol)"/>
                                </td>
                            </t>
                            <t t-foreach="flatMetricColumns()" t-as="mcol" t-key="mcol.id">
                                <td class="align-middle text-end o_list_number">
                                    <span t-esc="formatMetric(metricValue(row, mcol.block, mcol.metric))"/>
                                </td>
                            </t>
                            <td class="align-middle o_vtcd_ghi_chu">
                                <t t-if="isSubtotalRow(row)">
                                    <span t-esc="row.data.ghi_chu || ''"/>
                                </t>
                                <t t-else="">
                                    <textarea class="o_vtcd_ghi_chu_input form-control form-control-sm"
                                              rows="2"
                                              t-att-value="row.data.ghi_chu || ''"
                                              t-on-change="(ev) => this.onGhiChuInput(row, ev)"
                                              t-on-blur="(ev) => this.onGhiChuInput(row, ev)"
                                              placeholder="Ghi chú..."/>
                                </t>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>
    </t>

    <!-- Biểu 5 Bảng 2 — Tổng hợp KH đặt sản xuất -->
    <t t-name="sonha_vat_tu.VatTuBaoCaoKhDsxPivotRenderer">
        <div
            class="o_list_renderer o_renderer o_vat_tu_merged_list o_vat_tu_khdsx_pivot"
            t-att-class="uniqueRendererClass"
            tabindex="-1"
            t-ref="root"
        >
            <t t-if="showNoContentHelper" t-call="web.ActionHelper">
                <t t-set="noContentHelp" t-value="props.noContentHelp"/>
            </t>
            <table t-attf-class="o_list_table table table-sm table-hover position-relative mb-0 o_list_table_ungrouped table-striped" t-ref="table">
                <thead>
                    <tr class="text-center fw-bold">
                        <t t-foreach="getColumnGroups()" t-as="group" t-key="group.id">
                            <th t-att-colspan="group.span"
                                t-att-rowspan="group.rowspan || 1"
                                class="align-middle text-center o_khdsx_header"
                                tabindex="-1">
                                <span t-esc="group.label"/>
                            </th>
                        </t>
                    </tr>
                    <tr class="text-center fw-bold">
                        <t t-foreach="getQtySubColumns()" t-as="col" t-key="col.id">
                            <th class="align-middle text-center o_list_number_th" tabindex="-1">
                                <span t-esc="col.label"/>
                            </th>
                        </t>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="getPivotRows()" t-as="row" t-key="row.id">
                        <tr>
                            <td class="align-middle text-center">
                                <span t-esc="row.data.company_sx_code"/>
                            </td>
                            <td class="align-middle text-center">
                                <span t-esc="row.data.company_dat_code"/>
                            </td>
                            <td class="align-middle">
                                <span t-esc="row.data.nganh_hang"/>
                            </td>
                            <td class="align-middle text-end o_list_number">
                                <span t-esc="formatQty(row.data.ton_dau_ky)"/>
                            </td>
                            <t t-foreach="getQtySubColumns()" t-as="col" t-key="col.id">
                                <td class="align-middle text-end o_list_number">
                                    <span t-esc="formatMetric(metricValue(row, col.monthKey, col.groupKey), col.groupKey)"/>
                                </td>
                            </t>
                            <td class="align-middle o_khdsx_ghi_chu">
                                <textarea class="o_khdsx_ghi_chu_input form-control form-control-sm"
                                          rows="2"
                                          t-att-value="row.data.ghi_chu || ''"
                                          t-on-change="(ev) => this.onGhiChuInput(row, ev)"
                                          t-on-blur="(ev) => this.onGhiChuInput(row, ev)"
                                          placeholder="Ghi chú..."/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>
    </t>

</templates>
