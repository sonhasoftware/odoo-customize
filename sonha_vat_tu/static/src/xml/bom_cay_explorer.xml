<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sonha_vat_tu.BomCayExplorer">
        <div class="o_bom_cay_explorer o_action o_view_controller container-fluid h-100 d-flex flex-column p-3">
            <div class="row g-2 align-items-end mb-3">
                <div class="col-md-4">
                    <label class="form-label">Kế hoạch vật tư</label>
                    <select class="form-select" t-on-change="(ev) => this.onPeriodChange(ev.target.value)">
                        <t t-foreach="state.periods" t-as="p" t-key="p.id">
                            <option t-att-value="p.id" t-att-selected="p.id === state.periodId ? 'selected' : None">
                                <t t-esc="p.display_name"/>
                            </option>
                        </t>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Mã TP gốc</label>
                    <input class="form-control" list="bom_cay_ma_list" t-model="state.maTpGoc"/>
                    <datalist id="bom_cay_ma_list">
                        <t t-foreach="state.maList" t-as="m" t-key="m.ma">
                            <option t-att-value="m.ma"><t t-esc="m.ten"/></option>
                        </t>
                    </datalist>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Từ tháng</label>
                    <input class="form-control" t-model="state.thangTu" placeholder="MM/YYYY"/>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Đến tháng</label>
                    <input class="form-control" t-model="state.thangDen" placeholder="MM/YYYY"/>
                </div>
                <div class="col-md-1">
                    <button type="button" class="btn btn-primary w-100" t-on-click="loadTree"
                            t-att-disabled="state.loading ? 'disabled' : None">
                        <t t-if="state.loading">...</t>
                        <t t-else="">Xem</t>
                    </button>
                </div>
            </div>

            <t t-if="state.loaded">
                <div class="mb-2">
                    <strong t-esc="state.header.title"/>
                    <span class="text-muted ms-2" t-esc="state.header.range"/>
                    <span class="text-muted ms-2" t-if="state.header.chiNhanh">
                        (CN: <t t-esc="state.header.chiNhanh"/>)
                    </span>
                    <span class="badge text-bg-secondary ms-2" t-if="state.stats.nvl_on_tree">
                        Lá NVL cây: <t t-esc="state.stats.nvl_on_tree"/>
                        / ma_hang: <t t-esc="state.stats.nvl_in_ma_hang"/>
                        / định mức kỳ: <t t-esc="state.stats.nvl_on_dm"/>
                    </span>
                </div>

                <div class="row flex-grow-1 g-3 overflow-hidden" style="min-height: 280px;">
                    <div class="col-lg-5 d-flex flex-column">
                        <h6 class="border-bottom pb-1">Cây BOM</h6>
                        <div class="o_bom_cay_tree flex-grow-1 overflow-auto mb-0 p-2 bg-light border rounded">
                            <div class="o_bom_tree_line"><span class="o_bom_tree_ma" t-esc="state.header.ma"/><t t-esc="state.header.ten ? ' — ' + state.header.ten : ''"/><span class="o_bom_tree_sl"> (TP gốc)</span></div>
                            <t t-foreach="state.treeLines" t-as="line" t-key="line_index">
                                <div t-attf-class="o_bom_tree_line {{ line.on_dm ? 'o_bom_tree_line_mua' : '' }} {{ line.dim ? 'o_bom_tree_line_dim' : '' }}"><span class="o_bom_tree_prefix" t-esc="line.prefix"/><span t-attf-class="o_bom_tree_loai_{{ line.loai }}" t-esc="'[' + line.loai + '] '"/><span class="o_bom_tree_ma" t-esc="line.ma"/><t t-esc="line.ten ? ' ' + line.ten : ''"/><span class="o_bom_tree_sl" t-if="line.sl" t-esc="' × ' + line.sl"/></div>
                            </t>
                        </div>
                    </div>
                    <div class="col-lg-7 d-flex flex-column">
                        <h6 class="border-bottom pb-1">NVL trên định mức kỳ (mua / cần dùng)</h6>
                        <div class="table-responsive flex-grow-1 overflow-auto border rounded">
                            <table class="table table-sm table-striped table-hover mb-0 o_bom_cay_nvl_table">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>Mã NVL</th>
                                        <th>Tên NVL</th>
                                        <th class="text-end">Định mức</th>
                                        <t t-foreach="state.visibleMonths" t-as="mo" t-key="mo.offset">
                                            <th class="text-end" t-esc="'Kế hoạch ' + mo.label"/>
                                            <th class="text-end" t-esc="'Vật tư cần ' + mo.label"/>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="!state.nvlTable.length">
                                        <tr><td colspan="99" class="text-muted">Không có dòng định mức cho mã gốc này.</td></tr>
                                    </t>
                                    <t t-foreach="state.nvlTable" t-as="row" t-key="row.ma_nvl">
                                        <tr>
                                            <td t-esc="row.ma_nvl"/>
                                            <td t-esc="row.ten_nvl"/>
                                            <td class="text-end" t-esc="formatNum(row.sl_thuc_te, 6)"/>
                                            <t t-foreach="state.visibleMonths" t-as="mo" t-key="mo.offset">
                                                <td class="text-end" t-esc="monthQty(row, mo.offset, 'qty_kh')"/>
                                                <td class="text-end" t-esc="monthQty(row, mo.offset, 'qty_nvl')"/>
                                            </t>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
