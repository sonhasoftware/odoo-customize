<odoo>
    <data>
        <!-- Scheduled Action for updating attendance -->
        <record id="ir_cron_calculate_attendance" model="ir.cron">
            <field name="name">Bảng công chi tiết</field>
            <field name="model_id" ref="model_employee_attendance"/>
            <field name="state">code</field>
            <field name="code">model.update_attendance_data()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="doall">True</field>
        </record>

        <record id="ir_cron_calculate_attendance_v2" model="ir.cron">
            <field name="name">Tạp dữ liệu bảng công chi tiết (mới)</field>
            <field name="model_id" ref="model_employee_attendance_v2"/>
            <field name="state">code</field>
            <field name="code">model.update_attendance_data_v2()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="doall">True</field>
        </record>

        <record id="ir_cron_recompute_recent_attendance_v2" model="ir.cron">
            <field name="name">Tính lại bảng công chi tiết 3 ngày gần nhất</field>
            <field name="model_id" ref="model_employee_attendance_v2"/>
            <field name="state">code</field>
            <field name="code">model.update_recent_attendance_data_v2()</field>
            <field name="interval_number">8</field>
            <field name="interval_type">hours</field>
            <!-- ir.cron stores nextcall in UTC: 20:30 UTC = 03:30 Asia/Ho_Chi_Minh. -->
            <field name="nextcall" eval="(DateTime.now().replace(hour=19, minute=30, second=0, microsecond=0) + timedelta(days=1 if (DateTime.now().hour, DateTime.now().minute) >= (19, 30) else 0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="numbercall">-1</field>
            <field name="doall">False</field>
        </record>

        <record id="ir_cron_calculate_synthetic" model="ir.cron">
            <field name="name">Bảng công tổng hợp</field>
            <field name="model_id" ref="model_synthetic_work"/>
            <field name="state">code</field>
            <field name="code">model.create_synthetic()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="doall">True</field>
        </record>


        <record id="ir_cron_copy_attendance" model="ir.cron">
            <field name="name">Sao chép dữ liệu</field>
            <field name="model_id" ref="model_employee_attendance_store"/>
            <field name="state">code</field>
            <field name="code">model.copy_to_stored_model()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall">True</field>
        </record>

        <record id="ir_cron_compute_standard_work" model="ir.cron">
            <field name="name">Tạo dữ liệu công chuẩn cho các phòng ban</field>
            <field name="model_id" ref="model_config_standard_work"/>
            <field name="state">code</field>
            <field name="code">model.compute_standard_work()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall">True</field>
        </record>

        <record id="ir_cron_noti_miss_work" model="ir.cron">
            <field name="name">Thông báo thiếu dữ liệu công</field>
            <field name="model_id" ref="model_employee_attendance"/>
            <field name="state">code</field>
            <field name="code">model.noti_miss_work()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall">True</field>
        </record>

        <record id="ir_cron_them_phep" model="ir.cron">
            <field name="name">HR thêm phép hàng tháng, reset phép cũ</field>
            <field name="model_id" ref="model_form_word_slip"/>
            <field name="state">code</field>
            <field name="code">model.call_fn_them_phep()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall">True</field>
        </record>


        <record id="update_cong_v2" model="ir.cron">
            <field name="name">Cập nhật dữ liệu của Trung</field>
            <field name="model_id" ref="model_form_word_slip"/>
            <field name="state">code</field>
            <field name="code">model.job_word_slip_for_record()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="doall">True</field>
        </record>

        <record id="ir_cron_calculate_new_emp_attendance_v2" model="ir.cron">
            <field name="name">Tạo dữ liệu bảng công chi tiết nhân viên mới (mới)</field>
            <field name="model_id" ref="model_employee_attendance_v2"/>
            <field name="state">code</field>
            <field name="code">model.update_new_emp_attendance_data_v2()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall">True</field>
        </record>

        <record id="ir_cron_create_synthetic_new_emp" model="ir.cron">
            <field name="name">Tạo dữ liệu bảng công tổng hợp nhân viên mới</field>
            <field name="model_id" ref="model_synthetic_work"/>
            <field name="state">code</field>
            <field name="code">model.cron_create_synthetic_new_emp()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall">True</field>
        </record>
    </data>
</odoo>
