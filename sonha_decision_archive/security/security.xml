<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="module_category_decision_archive" model="ir.module.category">
            <field name="name">Kho Quyết định</field>
            <field name="description">Phân quyền tra cứu và quản lý kho quyết định công ty.</field>
            <field name="sequence">21</field>
        </record>

        <record id="group_decision_archive_manager" model="res.groups">
            <field name="name">Quản trị kho quyết định</field>
            <field name="category_id" ref="module_category_decision_archive"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_decision_archive_manager'))]"/>
        </record>

        <record id="rule_decision_category_company" model="ir.rule">
            <field name="name">Danh mục quyết định theo công ty</field>
            <field name="model_id" ref="model_decision_document_category"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_decision_document_company" model="ir.rule">
            <field name="name">Quyết định theo công ty</field>
            <field name="model_id" ref="model_decision_document"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_decision_document_user_published" model="ir.rule">
            <field name="name">Người dùng chỉ tra cứu tài liệu đã công bố</field>
            <field name="model_id" ref="model_decision_document"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('state', '=', 'published')]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_decision_document_manager_all" model="ir.rule">
            <field name="name">Quản trị xem toàn bộ trạng thái tài liệu</field>
            <field name="model_id" ref="model_decision_document"/>
            <field name="groups" eval="[(4, ref('group_decision_archive_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>

