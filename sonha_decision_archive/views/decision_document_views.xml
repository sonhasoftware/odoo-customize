<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_decision_document_tree" model="ir.ui.view">
        <field name="name">decision.document.tree</field>
        <field name="model">decision.document</field>
        <field name="arch" type="xml">
            <tree string="Kho quyết định" decoration-muted="state == 'archived'" decoration-info="state == 'draft'">
                <field name="has_file" column_invisible="True"/>
                <field name="issue_date"/>
                <field name="reference"/>
                <field name="name"/>
                <field name="document_type" optional="show"/>
                <field name="category_id"/>
                <field name="department_id" optional="show"/>
                <field name="employee_id" optional="show"/>
                <field name="signer" optional="hide"/>
                <field name="file_url" widget="url" string="Đường dẫn file" optional="show"/>
                <field name="state" widget="badge" optional="show"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'published'"
                       decoration-muted="state == 'archived'"/>
                <button name="action_open_file" type="object" string="Mở file" icon="fa-external-link" invisible="not has_file"/>
            </tree>
        </field>
    </record>

    <record id="view_decision_document_form" model="ir.ui.view">
        <field name="name">decision.document.form</field>
        <field name="model">decision.document</field>
        <field name="arch" type="xml">
            <form string="Quyết định / Tài liệu">
                <header>
                    <button name="action_publish" type="object" string="Công bố" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_archive_document" type="object" string="Lưu trữ" invisible="state != 'published'"/>
                    <button name="action_reset_draft" type="object" string="Chuyển về bản nháp" invisible="state == 'draft'"/>
                    <button name="action_open_file" type="object" string="Mở file" class="btn-secondary" icon="fa-external-link" invisible="not has_file"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,published,archived"/>
                </header>
                <sheet>
                    <field name="has_file" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Tên quyết định hoặc tài liệu..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="reference"/>
                            <field name="document_type"/>
                            <field name="category_id"/>
                            <field name="department_id"/>
                            <field name="employee_id"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="effective_date"/>
                            <field name="expiry_date"/>
                            <field name="signer"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="File và đường dẫn" name="file_source">
                            <group>
                                <field name="file_data" filename="file_name"/>
                                <field name="file_name" invisible="1"/>
                                <field name="external_url" widget="url" placeholder="https://..."/>
                                <field name="file_url" widget="url" readonly="1" invisible="not file_url"/>
                            </group>
                            <div class="alert alert-info" role="alert">
                                Có thể tải file trực tiếp lên Odoo hoặc nhập một đường dẫn HTTPS tới kho tài liệu bên ngoài.
                            </div>
                        </page>
                        <page string="Nội dung tra cứu" name="search_content">
                            <group>
                                <field name="keywords" placeholder="nhân sự, bổ nhiệm, điều chuyển..."/>
                                <field name="summary" placeholder="Tóm tắt nội dung để người dùng nhận biết tài liệu..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_decision_document_search" model="ir.ui.view">
        <field name="name">decision.document.search</field>
        <field name="model">decision.document</field>
        <field name="arch" type="xml">
            <search string="Tra cứu quyết định">
                <field name="name" string="Từ khóa"
                       filter_domain="['|', '|', '|', ('name', 'ilike', self), ('reference', 'ilike', self), ('keywords', 'ilike', self), ('summary', 'ilike', self)]"/>
                <field name="reference"/>
                <field name="category_id"/>
                <field name="department_id"/>
                <field name="employee_id"/>
                <field name="document_type"/>
                <field name="issue_date"/>
                <filter string="Có file" name="has_file" domain="['|', ('file_data', '!=', False), ('external_url', '!=', False)]"/>
                <filter string="Đang hiệu lực" name="effective"
                        domain="[('state', '=', 'published'), '|', ('effective_date', '=', False), ('effective_date', '&lt;=', context_today()), '|', ('expiry_date', '=', False), ('expiry_date', '&gt;=', context_today())]"/>
                <separator/>
                <filter string="Bản nháp" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Đã công bố" name="published" domain="[('state', '=', 'published')]"/>
                <filter string="Đã lưu trữ" name="archived" domain="[('state', '=', 'archived')]"/>
                <group expand="0" string="Nhóm theo">
                    <filter string="Đầu mục tài liệu" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Phòng ban" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Nhân viên" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Loại tài liệu" name="group_type" context="{'group_by': 'document_type'}"/>
                    <filter string="Năm ban hành" name="group_issue_year" context="{'group_by': 'issue_date:year'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_decision_document_search" model="ir.actions.act_window">
        <field name="name">Tra cứu quyết định</field>
        <field name="res_model">decision.document</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_decision_document_search"/>
        <field name="domain">[('state', '=', 'published')]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa có quyết định nào được công bố.</p>
            <p>Nhập từ khóa, số quyết định, phòng ban hoặc nhân viên trên thanh tìm kiếm.</p>
        </field>
    </record>

    <record id="action_decision_document_manage" model="ir.actions.act_window">
        <field name="name">Quản lý quyết định</field>
        <field name="res_model">decision.document</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_decision_document_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Thêm quyết định hoặc tài liệu đầu tiên.</p>
            <p>Tải file lên, gắn đầu mục, phòng ban, nhân viên và công bố để người dùng tra cứu.</p>
        </field>
    </record>
</odoo>

