<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Full-screen Client Action for OWL Chatbot Dashboard -->
    <record id="action_topic_chatbot_dashboard" model="ir.actions.client">
        <field name="name">Chatbot Dashboard</field>
        <field name="tag">topic_chatbot.dashboard</field>
        <field name="target">current</field>
    </record>

    <!-- Main Menus -->
    <menuitem id="menu_topic_chatbot_root"
              name="Topic Chatbot"
              groups="topic_chatbot.group_topic_chatbot_user"
              sequence="10"/>

    <menuitem id="menu_topic_chatbot_dashboard"
              name="Chatbot"
              parent="menu_topic_chatbot_root"
              action="action_topic_chatbot_dashboard"
              sequence="10"/>

    <menuitem id="menu_topic_chatbot_topics"
              name="Topics"
              parent="menu_topic_chatbot_root"
              action="action_topic_chatbot_topic"
              sequence="20"/>

    <menuitem id="menu_topic_chatbot_documents"
              name="Documents"
              parent="menu_topic_chatbot_root"
              action="action_topic_chatbot_document"
              sequence="25"/>

    <menuitem id="menu_topic_chatbot_config_root"
              name="Configuration"
              parent="menu_topic_chatbot_root"
              groups="topic_chatbot.group_topic_chatbot_admin"
              sequence="100"/>

    <menuitem id="menu_topic_chatbot_settings"
              name="Settings"
              parent="menu_topic_chatbot_config_root"
              action="action_topic_chatbot_config"
              sequence="10"/>

    <menuitem id="menu_topic_chatbot_mssql_connection"
              name="SQL Connections"
              parent="menu_topic_chatbot_config_root"
              action="action_mssql_connection"
              sequence="20"/>

    <menuitem id="menu_topic_chatbot_mssql_log"
              name="SQL Logs"
              parent="menu_topic_chatbot_config_root"
              action="action_mssql_log"
              sequence="30"/>

    <menuitem id="menu_topic_chatbot_rag_log"
              name="RAG Logs"
              parent="menu_topic_chatbot_config_root"
              action="action_rag_log"
              sequence="35"/>

    <menuitem id="menu_topic_chatbot_ocr_job"
              name="OCR Pilot Stats"
              parent="menu_topic_chatbot_config_root"
              action="action_topic_chatbot_ocr_job"
              sequence="37"/>
</odoo>
