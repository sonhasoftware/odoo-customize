<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.topic_chatbot</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="99"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Topic Chatbot" string="Topic Chatbot" name="topic_chatbot">
                    <block title="Mô hình Chat (LLM Provider)" id="topic_chatbot_llm_config">
                        <setting string="Chế độ Chat LLM Provider" help="Chọn 'Google Gemini (Cloud)' hoặc 'Ollama Server nội bộ (100% Offline / On-Premise)'.">
                            <field name="topic_chatbot_llm_provider" widget="radio"/>
                        </setting>
                        <setting string="Ollama Chat Model" help="Tên model chat trên server Ollama. Khuyến nghị: qwen2.5:14b hoặc qwen2.5:7b." invisible="topic_chatbot_llm_provider != 'ollama'">
                            <field name="topic_chatbot_ollama_chat_model"/>
                        </setting>
                        <setting string="Gemini API Key" help="Nhập Google Gemini API Key." invisible="topic_chatbot_llm_provider == 'ollama'">
                            <field name="topic_chatbot_gemini_api_key" password="True"/>
                        </setting>
                        <setting string="Gemini Model" help="Chọn model Gemini (ví dụ: gemini-3.6-flash, gemini-3.5-flash)." invisible="topic_chatbot_llm_provider == 'ollama'">
                            <field name="topic_chatbot_gemini_model"/>
                        </setting>
                        <setting string="Custom Stop Words" help="Comma-separated stop words to ignore during RAG search.">
                            <field name="topic_chatbot_stop_words"/>
                        </setting>
                    </block>
                    <block title="Cấu hình Vector Embedding &amp; Tìm kiếm Ngữ nghĩa" id="topic_chatbot_embedding_config">
                        <setting string="Chế độ Embedding Provider" help="Chọn 'Google Gemini' (ưu tiên Cloud, tự động fallback sang Ollama khi hết quota) hoặc 'Ollama Local' (chạy 100% offline nội bộ, không liên quan tới Gemini).">
                            <field name="topic_chatbot_embedding_provider" widget="radio"/>
                        </setting>
                        <setting string="Gemini Embedding Model" help="Gemini Embedding Model cho Vector Search (mặc định: gemini-embedding-2)." invisible="topic_chatbot_embedding_provider == 'ollama'">
                            <field name="topic_chatbot_embedding_model"/>
                        </setting>
                        <setting string="Embedding Batch Size" help="Số lượng đoạn text gửi trong 1 request API batch (mặc định: 50, tối đa: 100)." invisible="topic_chatbot_embedding_provider == 'ollama'">
                            <field name="topic_chatbot_embedding_batch_size"/>
                        </setting>
                        <setting string="Delay giữa các batch (giây)" help="Thời gian nghỉ giữa các lần gọi API batch để tránh rate limit (mặc định: 1.5s)." invisible="topic_chatbot_embedding_provider == 'ollama'">
                            <field name="topic_chatbot_embedding_batch_delay_seconds"/>
                        </setting>
                        <setting string="Ollama Server URL" help="Địa chỉ dịch vụ Ollama nội bộ (mặc định: http://localhost:11434).">
                            <field name="topic_chatbot_ollama_url"/>
                        </setting>
                        <setting string="Ollama Embedding Model" help="Tên model embedding trên Ollama. Khuyến nghị: bge-m3 (chuẩn 1024 chiều tối ưu tiếng Việt tương thích pgvector).">
                            <field name="topic_chatbot_ollama_model"/>
                        </setting>
                        <div class="mt16">
                            <button name="action_test_ollama_connection" string="Kiểm tra kết nối Ollama" type="object" class="btn-secondary" icon="fa-bolt"/>
                        </div>
                    </block>
                    <block title="Cấu hình OCR &amp; Nhận Dạng Hình Ảnh (Pilot v2)" id="topic_chatbot_ocr_config">
                        <setting string="Bật xử lý ảnh trong tài liệu" help="Tự động bóc tách và trích xuất nội dung từ hình ảnh, sơ đồ trong tệp PDF và DOCX.">
                            <field name="topic_chatbot_enable_image_ocr"/>
                        </setting>
                        <setting string="OCR Provider (Text / Bảng biểu)" help="Phương thức OCR ký tự xác định cho ảnh bảng số liệu, văn bản scan để chống hallucination." invisible="not topic_chatbot_enable_image_ocr">
                            <field name="topic_chatbot_ocr_provider"/>
                        </setting>
                        <setting string="Vision Provider (Sơ đồ / Lưu đồ)" help="Mô hình VLM hiểu ngữ nghĩa cho lưu đồ quy trình, sơ đồ khối." invisible="not topic_chatbot_enable_image_ocr">
                            <field name="topic_chatbot_vision_provider"/>
                        </setting>
                        <setting string="Ollama Vision Model" help="Tên model Vision trên Ollama (ví dụ: moondream, llava-phi3 hoặc minicpm-v)." invisible="not topic_chatbot_enable_image_ocr or topic_chatbot_vision_provider != 'ollama'">
                            <field name="topic_chatbot_ollama_vision_model"/>
                        </setting>
                        <setting string="Chế độ xử lý OCR" help="Khuyến nghị chọn 'Hàng đợi tuần tự' để chạy 1 job tại một thời điểm, bảo vệ CPU cho Chatbot." invisible="not topic_chatbot_enable_image_ocr">
                            <field name="topic_chatbot_ocr_processing_mode"/>
                        </setting>
                        <setting string="Số luồng CPU cho OCR/Vision" help="Số core CPU cấp cho Ollama Vision hoặc PaddleOCR (mặc định chừa 2 luồng cho Odoo và Windows)." invisible="not topic_chatbot_enable_image_ocr">
                            <field name="topic_chatbot_ocr_num_threads"/>
                        </setting>
                        <setting string="Giới hạn số ảnh / tài liệu" help="Số ảnh tối đa được OCR trong 1 tài liệu (tránh nghẽn CPU khi file có quá nhiều ảnh)." invisible="not topic_chatbot_enable_image_ocr">
                            <field name="topic_chatbot_ocr_max_images"/>
                        </setting>
                        <setting string="Kích thước ảnh tối thiểu (px)" help="Bỏ qua các ảnh nhỏ hơn kích thước này (loại trừ icon, logo nhỏ)." invisible="not topic_chatbot_enable_image_ocr">
                            <field name="topic_chatbot_ocr_min_dimension"/>
                        </setting>
                        <div class="mt16" invisible="not topic_chatbot_enable_image_ocr">
                            <button name="action_test_paddleocr_connection" string="Kiểm tra PaddleOCR Engine" type="object" class="btn-secondary me-2" icon="fa-font"/>
                            <button name="action_test_ollama_vision_connection" string="Kiểm tra Ollama Vision Model" type="object" class="btn-secondary" icon="fa-eye"/>
                        </div>
                    </block>
                    <block title="Microsoft SQL Server Connection" id="topic_chatbot_mssql_config">
                        <setting string="Kích hoạt SQL Server" help="Bật tính năng kết nối và truy vấn CSDL Microsoft SQL Server.">
                            <field name="topic_chatbot_mssql_enabled"/>
                        </setting>
                        <setting string="SQL Server Host" help="IP hoặc Tên Server SQL Server (ví dụ: localhost, 192.168.1.100, SERVER\INSTANCE)." invisible="not topic_chatbot_mssql_enabled">
                            <field name="topic_chatbot_mssql_host"/>
                        </setting>
                        <setting string="SQL Server Port" help="Cổng kết nối SQL Server (mặc định: 1433)." invisible="not topic_chatbot_mssql_enabled">
                            <field name="topic_chatbot_mssql_port"/>
                        </setting>
                        <setting string="Database Name" help="Tên CSDL SQL Server cần truy vấn." invisible="not topic_chatbot_mssql_enabled">
                            <field name="topic_chatbot_mssql_db"/>
                        </setting>
                        <setting string="SQL Server User" help="Tài khoản đăng nhập SQL Server." invisible="not topic_chatbot_mssql_enabled">
                            <field name="topic_chatbot_mssql_user"/>
                        </setting>
                        <setting string="SQL Server Password"
                                 help="Mật khẩu được mã hóa AES-256 (Fernet/PBKDF2) trước khi lưu vào database. Không bao giờ lưu dạng plaintext."
                                 invisible="not topic_chatbot_mssql_enabled">
                            <field name="topic_chatbot_mssql_password" password="True"/>
                        </setting>
                        <setting string="ODBC Driver" help="Tên Driver ODBC trên hệ thống (ví dụ: ODBC Driver 17 for SQL Server)." invisible="not topic_chatbot_mssql_enabled">
                            <field name="topic_chatbot_mssql_driver"/>
                        </setting>
                        <div class="mt16" invisible="not topic_chatbot_mssql_enabled">
                            <button name="action_test_mssql_connection" string="Test Connection" type="object" class="btn-primary" icon="fa-plug"/>
                        </div>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_topic_chatbot_config" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'topic_chatbot'}</field>
    </record>
</odoo>
