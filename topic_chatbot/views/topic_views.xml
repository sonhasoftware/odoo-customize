<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Topic Form View -->
    <record id="view_topic_chatbot_topic_form" model="ir.ui.view">
        <field name="name">topic_chatbot.topic.form</field>
        <field name="model">topic_chatbot.topic</field>
        <field name="arch" type="xml">
            <form string="Topic">
                <header>
                    <button name="action_process_all_documents" string="Xử lý tài liệu" type="object" class="btn-primary" icon="fa-cogs"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g., HR Policies, Sales Handbook"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="is_admin" invisible="1"/>
                            <field name="is_public" readonly="not is_admin"/>
                            <field name="is_db_query"/>
                            <field name="is_mssql_query"/>
                            <field name="create_uid" readonly="1" string="Owner"/>
                        </group>
                    </group>
                    <group invisible="not is_mssql_query">
                        <field name="mssql_allowed_tables" placeholder="Ví dụ: dbo.FactSales (Doanh số bán hàng), dbo.DimCustomer (Thông tin khách hàng)..."/>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Summarize the scope of this topic..."/>
                        </page>
                        <page string="Documents" name="documents">
                            <field name="document_ids" context="{'default_topic_id': active_id}">
                                <tree string="Documents" editable="bottom">
                                    <field name="name"/>
                                    <field name="filename" column_invisible="True"/>
                                    <field name="datas" filename="filename" string="Upload File" options="{'accepted_file_extensions': '.pdf,.docx,.xlsx,.xls,.csv,.txt'}"/>
                                    <field name="state" readonly="1" decoration-info="state == 'draft'" decoration-warning="state == 'processing'" decoration-success="state == 'done'" decoration-danger="state == 'error'"/>
                                    <field name="layout_type" readonly="1" optional="hide"/>
                                    <button name="action_process_document" string=" Xử lý" type="object" icon="fa-play" class="btn-secondary"/>
                                    <field name="create_date" string="Uploaded On" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- Topic Tree View -->
    <record id="view_topic_chatbot_topic_tree" model="ir.ui.view">
        <field name="name">topic_chatbot.topic.tree</field>
        <field name="model">topic_chatbot.topic</field>
        <field name="arch" type="xml">
            <tree string="Topics">
                <field name="name"/>
                <field name="description"/>
                <field name="is_public"/>
                <field name="is_db_query"/>
                <field name="is_mssql_query"/>
                <field name="create_uid" string="Owner"/>
                <field name="create_date" string="Created On"/>
            </tree>
        </field>
    </record>

    <!-- Topic Search View -->
    <record id="view_topic_chatbot_topic_search" model="ir.ui.view">
        <field name="name">topic_chatbot.topic.search</field>
        <field name="model">topic_chatbot.topic</field>
        <field name="arch" type="xml">
            <search string="Search Topics">
                <field name="name"/>
                <field name="description"/>
                <field name="mssql_allowed_tables"/>
                <filter string="Public" name="public" domain="[('is_public', '=', True)]"/>
                <filter string="Private" name="private" domain="[('is_public', '=', False)]"/>
                <filter string="Hỏi dữ liệu DB (Odoo)" name="db_query" domain="[('is_db_query', '=', True)]"/>
                <filter string="Hỏi dữ liệu SQL Server" name="mssql_query" domain="[('is_mssql_query', '=', True)]"/>
                <filter string="My Topics" name="my_topics" domain="[('create_uid', '=', uid)]"/>
            </search>
        </field>
    </record>

    <!-- Topic Action -->
    <record id="action_topic_chatbot_topic" model="ir.actions.act_window">
        <field name="name">Topics</field>
        <field name="res_model">topic_chatbot.topic</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_topic_chatbot_topic_search"/>
    </record>
</odoo>
