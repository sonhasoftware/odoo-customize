<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="mail_template_nhiem_vu_sap_den_han" model="mail.template">
            <field name="name">Nhắc công việc sắp đến hạn</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="email_from">adminservices@sonha.com.vn</field>
            <field name="email_to"></field>
            <field name="subject">CÔNG VIỆC CẦN THỰC HIỆN</field>
            <field name="body_html" type="html">
                <div style="margin:0;padding:24px;background:#f5f5f5;font-family:Arial,Helvetica,sans-serif;">
                    <div style="max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #d9d9d9;padding:28px 32px;">
                        <p style="margin:0 0 8px 0;font-size:13px;color:#666666;">
                            Của bạn Công việc cần thực hiện
                        </p>
                        <h1 style="margin:0 0 16px 0;font-size:22px;font-weight:700;color:#1a1a1a;letter-spacing:0.3px;">
                            CÔNG VIỆC CẦN THỰC HIỆN
                        </h1>
                        <hr style="border:none;border-top:1px solid #e5e5e5;margin:0 0 20px 0;"/>
                        <p style="margin:0 0 16px 0;font-size:14px;color:#333333;line-height:1.5;">
                            Bạn có một Công việc cần thực hiện :
                            <t t-out="object.name or ''"/>
                        </p>
                        <p style="margin:0 0 8px 0;font-size:14px;color:#333333;line-height:1.6;">
                            <strong>Tiêu đề:</strong>
                            <t t-out="object.name or ''"/>
                        </p>
                        <p style="margin:0 0 8px 0;font-size:14px;color:#333333;line-height:1.6;">
                            <strong>Ngày đến hạn:</strong>
                            <t t-out="object._get_deadline_mail_date_display()"/>
                        </p>
                        <p style="margin:0 0 8px 0;font-size:14px;color:#333333;line-height:1.6;">
                            <strong>Dự án:</strong>
                            <t t-out="object._get_deadline_mail_project_name()"/>
                        </p>
                        <p style="margin:0 0 24px 0;font-size:14px;color:#333333;line-height:1.6;">
                            <strong>Nhân sự làm:</strong>
                            <t t-out="object._get_deadline_mail_ns_lam()"/>
                        </p>
                        <div style="text-align:left;margin:0 0 28px 0;">
                            <a t-att-href="ctx.get('task_link')"
                               target="_blank"
                               style="display:inline-block;background:#c4a574;color:#ffffff;text-decoration:none;padding:10px 22px;font-size:14px;font-weight:600;border-radius:2px;">
                                Xem chi tiết
                            </a>
                        </div>
                        <hr style="border:none;border-top:1px solid #e5e5e5;margin:0 0 16px 0;"/>
                        <p style="margin:0;text-align:center;font-size:12px;color:#888888;line-height:1.6;">
                            SHI - Công Ty Cổ Phần Quốc Tế Sơn Hà
                            <br/>
                            | adminservices@sonha.com.vn
                        </p>
                    </div>
                </div>
            </field>
        </record>
    </data>
</odoo>
