<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_project_task_pending_wizard_form" model="ir.ui.view">
        <field name="name">project.task.pending.wizard.form</field>
        <field name="model">project.task.pending.wizard</field>
        <field name="arch" type="xml">
            <form string="Pending nhiệm vụ">
                <group>
                    <field name="task_id" invisible="1"/>
                    <field name="ly_do_pending" placeholder="Nhập lý do Pending..."/>
                    <field name="so_ngay_pending"/>
                </group>
                <footer>
                    <button name="action_confirm"
                            string="Xác nhận Pending"
                            type="object"
                            class="btn-primary"/>
                    <button string="Hủy"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>