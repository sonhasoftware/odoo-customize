<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_bao_cao_du_an_wizard_form" model="ir.ui.view">
        <field name="name">sonha.du.an.bao.cao.wizard.form</field>
        <field name="model">sonha.du.an.bao.cao.wizard</field>
        <field name="arch" type="xml">
            <form string="Tạo báo cáo dự án">
                <group>
                    <field name="tu_ngay"/>
                    <field name="den_ngay"/>
                    <field name="du_an_cha_id"/>
                </group>
                <footer>
                    <button name="action_generate_report" type="object" string="Tạo báo cáo" class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
