<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="sonha_du_an_cat_security">
        <field name="name">Dự án Sơn Hà</field>
        <field name="sequence">10</field>
    </record>

    <record id="group_user_du_an" model="res.groups">
        <field name="name">Nhân viên</field>
        <field name="category_id" ref="sonha_du_an_cat_security"/>
    </record>

    <record id="group_manager_du_an" model="res.groups">
        <field name="name">Quản lý dự án</field>
        <field name="category_id" ref="sonha_du_an_cat_security"/>
        <field name="implied_ids" eval="[(4, ref('sonha_du_an.group_user_du_an'))]"/>
    </record>

    <record id="group_admin_du_an" model="res.groups">
        <field name="name">Admin</field>
        <field name="category_id" ref="sonha_du_an_cat_security"/>
        <field name="implied_ids" eval="[(4, ref('sonha_du_an.group_manager_du_an'))]"/>
    </record>

    <record id="rule_sonha_project_user_read" model="ir.rule">
        <field name="name">Dự án: nhân viên xem dự án liên quan</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">['|', '|', ('nguoi_qlda', 'in', [user.id]), ('task_ids.ns_lam', 'in', [user.id]), ('task_ids.chu_so_huu', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('sonha_du_an.group_user_du_an'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_sonha_project_user_write" model="ir.rule">
        <field name="name">Dự án: nhân viên sửa dự án của mình</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">[('nguoi_qlda', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('sonha_du_an.group_user_du_an'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_sonha_task_user_read" model="ir.rule">
        <field name="name">Nhiệm vụ: nhân viên xem nhiệm vụ của mình</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">['|', '|', ('ns_lam', 'in', [user.id]), ('chu_so_huu', 'in', [user.id]), ('project_id.nguoi_qlda', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('sonha_du_an.group_user_du_an'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_sonha_task_user_write" model="ir.rule">
        <field name="name">Nhiệm vụ: nhân viên sửa nhiệm vụ của mình</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[('chu_so_huu', 'in', [user.id])]</field>
        <field name="groups" eval="[(4, ref('sonha_du_an.group_user_du_an'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_sonha_project_manager_read_all" model="ir.rule">
        <field name="name">Dự án: quản lý dự án xem tất cả</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sonha_du_an.group_manager_du_an'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_sonha_task_manager_read_all" model="ir.rule">
        <field name="name">Nhiệm vụ: quản lý dự án xem tất cả</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sonha_du_an.group_manager_du_an'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_sonha_project_admin_all" model="ir.rule">
        <field name="name">Dự án: admin toàn quyền</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sonha_du_an.group_admin_du_an'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_sonha_task_admin_all" model="ir.rule">
        <field name="name">Nhiệm vụ: admin toàn quyền</field>
        <field name="model_id" ref="project.model_project_task"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sonha_du_an.group_admin_du_an'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
