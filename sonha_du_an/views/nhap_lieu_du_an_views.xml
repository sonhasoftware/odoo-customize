<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_nhap_lieu_du_an_form" model="ir.ui.view">
        <field name="name">view.nhap.lieu.du.an.form</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <form string="Nhập liệu dự án">
                <sheet>
                    <group>
                        <group>
                            <field name="so_du_an"/>
                            <field name="group_du_an"/>
                            <field name="name"/>
                            <field name="noi_dung"/>
                            <field name="du_an_cha_id" domain="[('id', '!=', id)]"/>
                        </group>
                        <group>
                            <field name="nguoi_qlda"/>
                            <field name="ngay_kt_da"/>
                            <field name="ngay_kt_chinh_sua"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Dự án con">
                            <field name="du_an_con_ids" string="" context="{'default_du_an_cha_id': id}">
                                <tree editable="bottom">
                                    <field name="so_du_an"/>
                                    <field name="group_du_an"/>
                                    <field name="name"/>
                                    <field name="noi_dung"/>
                                    <field name="nguoi_qlda"/>
                                    <field name="ngay_kt_da"/>
                                    <field name="ngay_kt_chinh_sua"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Nhập nhiệm vụ">
                            <field name="task_ids" string="">
                                <tree editable="bottom">
                                    <field name="cap"/>
                                    <field name="name" required="0"/>
                                    <field name="noi_dung_cv"/>
                                    <field name="so_ngay_ht"/>
                                    <field name="ngay_bat_dau"/>
                                    <field name="ngay_ket_thuc"/>
                                    <field name="ngay_hoan_thanh"/>
                                    <field name="ns_lam"/>
                                    <field name="chu_so_huu"/>
                              </tree>
                          </field>
                      </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_nhap_lieu_du_an_tree" model="ir.ui.view">
        <field name="name">view.nhap.lieu.du.an.tree</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <tree string="Nhập liệu dự án">
                <field name="so_du_an"/>
                    <field name="group_du_an"/>
                    <field name="name"/>
                    <field name="du_an_cha_id"/>
                    <field name="noi_dung"/>
                    <field name="nguoi_qlda"/>
                    <field name="ngay_kt_da"/>
                    <field name="ngay_kt_chinh_sua"/>
            </tree>
        </field>
    </record>

    <record id="action_nhap_lieu_du_an" model="ir.actions.act_window">
            <field name="name">Nhập liệu dự án</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">project.project</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_nhap_lieu_du_an_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_nhap_lieu_du_an_form')})]"/>
        </record>

    <record id="action_theo_doi_nhiem_vu_du_an_con" model="ir.actions.act_window">
        <field name="name">Theo dõi nhiệm vụ dự án con</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">project.project</field>
        <field name="domain">[('du_an_cha_id', '!=', False)]</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_favorite_projects': 0}</field>
    </record>
</odoo>
