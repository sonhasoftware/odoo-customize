<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_nhap_lieu_du_an_form" model="ir.ui.view">
        <field name="name">view.nhap.lieu.du.an.form</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <form string="Nhập liệu dự án">
                <sheet>
                    <group>
                        <group>
                            <field name="so_du_an"/>
                            <field name="group_du_an"/>
                            <field name="name"/>
                            <field name="noi_dung"/>
                            <field name="du_an_cha_id" invisible="1"/>
                            <field name="du_an_cha" readonly="du_an_cha_id"/>
                        </group>
                        <group>
                            <field name="nguoi_qlda" widget="many2many_tags"/>
                            <field name="ngay_kt_da"/>
                            <field name="ngay_kt_chinh_sua"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Dự án con">
                            <field name="du_an_con_ids" string="" context="{'default_du_an_cha_id': id, 'default_du_an_cha': False}">
                                <tree editable="bottom">
                                    <field name="du_an_cha" column_invisible="1"/>
                                    <field name="name" string="Nội dung dự án"/>
                                    <field name="nguoi_qlda" widget="many2many_tags"/>
                                    <field name="ngay_kt_da"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Nhập nhiệm vụ">
                            <field name="nhiem_vu_du_an_ids" string="" context="{'default_du_an_cha_task_id': id}">
                                <tree editable="bottom">
                                    <field name="cap" domain="[('du_an_cha_id', '=', parent.id), ('du_an_cha', '=', False)]" context="{'default_du_an_cha_id': parent.id, 'default_du_an_cha': False}"/>
                                    <field name="name" required="0" string="Nội dung công việc"/>
                                    <field name="so_ngay_ht"/>
                                    <field name="ngay_bat_dau"/>
                                    <field name="ngay_ket_thuc"/>
                                    <field name="ngay_hoan_thanh"/>
                                    <field name="ns_lam" widget="many2many_tags"/>
                                    <field name="chu_so_huu" widget="many2many_tags"/>
                                    <field name="so_ngay_pending"/>
                              </tree>
                          </field>
                      </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_nhap_lieu_du_an_tree" model="ir.ui.view">
        <field name="name">view.nhap.lieu.du.an.tree</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <tree string="Nhập liệu dự án">
                <field name="so_du_an"/>
                    <field name="group_du_an"/>
                    <field name="name"/>
                    <field name="du_an_cha_id"/>
                    <field name="noi_dung"/>
                    <field name="nguoi_qlda"/>
                    <field name="ngay_kt_da"/>
                    <field name="ngay_kt_chinh_sua"/>
            </tree>
        </field>
    </record>

    <record id="view_nhap_lieu_du_an_kanban" model="ir.ui.view">
        <field name="name">view.nhap.lieu.du.an.kanban</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="group_du_an" class="o_kanban_mobile">
                <field name="name"/>
                <field name="so_du_an"/>
                <field name="group_du_an"/>
                <field name="noi_dung"/>
                <field name="nguoi_qlda"/>
                <field name="ngay_kt_da"/>
                <templates>
                    <t t-name="kanban-box">
                        <a type="object" name="action_view_tasks" class="o_kanban_record d-block">
                            <div class="o_kanban_record_title">
                                <strong><field name="name"/></strong>
                            </div>
                            <div t-if="record.so_du_an.raw_value" class="text-muted">
                                <field name="so_du_an"/>
                            </div>
                            <div t-if="record.noi_dung.raw_value" class="mt-2">
                                <field name="noi_dung"/>
                            </div>
                            <div class="mt-2" t-if="record.nguoi_qlda.raw_value">
                                <field name="nguoi_qlda" widget="many2many_avatar_user"/>
                            </div>
                            <div class="mt-2" t-if="record.ngay_kt_da.raw_value">
                                <span class="text-muted">Hạn kết thúc: </span>
                                <field name="ngay_kt_da"/>
                            </div>
                        </a>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_nhap_lieu_du_an" model="ir.actions.act_window">
            <field name="name">Nhập liệu dự án</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">project.project</field>
            <field name="context">{'default_du_an_cha': True}</field>
            <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'tree', 'view_id': ref('view_nhap_lieu_du_an_tree')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_nhap_lieu_du_an_form')})]"/>
            <field name="domain">[('du_an_cha', '=', True)]</field>
        </record>

    <!-- Replace the standard Project menu's initial view, not the data-entry action. -->
    <record id="project.open_view_project_all" model="ir.actions.act_window">
        <field name="view_id" ref="view_nhap_lieu_du_an_kanban"/>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'group_by': 'group_du_an'}</field>
    </record>

    <record id="action_theo_doi_nhiem_vu_du_an_con" model="ir.actions.act_window">
        <field name="name">Theo dõi nhiệm vụ dự án con</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">project.project</field>
        <field name="domain">[('du_an_cha_id', '!=', False)]</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_favorite_projects': 0}</field>
    </record>
</odoo>
